{
  "name": "gestao-de-fila-reservas",
  "version": "1.0.0",
  "description": "Gestão de filas de espera e reservas de mesas para restaurantes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.testes.json && tsc -p web/tsconfig.testes-servidor.json",
    "lint": "biome check src web ferramentas",
    "format": "biome check --write src web ferramentas",
    "verificar": "npm run lint && npm run typecheck && npm test && npm run build && npm run web:build",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:env": "node --env-file=.env dist/main.js",
    "tudo": "node ferramentas/subir.mjs",
    "conferir:instalacao": "node ferramentas/conferir-instalacao.mjs",
    "tudo:env": "node --env-file=.env ferramentas/subir.mjs",
    "demo": "node dist/demo.js",
    "web:build": "tsc -p web/tsconfig.servidor.json && tsc -p web/tsconfig.navegador.json",
    "web": "node web/dist/servidor.js",
    "web:env": "node --env-file=.env web/dist/servidor.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"web/navegador/*.test.ts\" \"web/servidor/*.test.ts\""
  },
  "keywords": [
    "restaurante",
    "fila-de-espera",
    "reservas"
  ],
  "author": "Luiz Fialho",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
