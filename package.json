{
  "name": "gestao-de-fila-reservas",
  "version": "1.0.0",
  "description": "Gestão de filas de espera e reservas de mesas para restaurantes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome check --write src",
    "verificar": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:env": "node --env-file=.env dist/main.js",
    "simular": "node dist/main.js",
    "demo": "node dist/demo.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "keywords": [
    "restaurante",
    "fila-de-espera",
    "reservas"
  ],
  "author": "Luiz Fialho",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
