# Copie para .env e preencha. O .env fica fora do git.
#   cp .env.example .env

# ---------------------------------------------------------------- serviço ---
PORTA=3000

# Token da equipe, exigido em toda rota menos /saude.
# Gere um: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SALAO_TOKEN=

# Caminho de um arquivo SQLite. Comente para manter o salão só em memória.
SALAO_BANCO=./salao.db

# ------------------------------------------------------------------ painel ---
# O painel roda num processo próprio: é ele que guarda o token, para que o
# navegador nunca veja. Use o mesmo SALAO_TOKEN acima.
PORTA_WEB=5173
SALAO_API=http://127.0.0.1:3000
