# Copie para .env e preencha. O .env fica fora do git.
#   cp .env.example .env

# ---------------------------------------------------------------- serviço ---
PORTA=3000

# Token da equipe, exigido em toda rota menos /saude.
# Gere um: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SALAO_TOKEN=

# Caminho de um arquivo SQLite. Comente para manter o salão só em memória.
SALAO_BANCO=./salao.db

# ------------------------------------------------------------- notificação ---
# Sem estas três, o aviso vai só para o log e o serviço avisa na partida.

# Console da Twilio, painel inicial.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# sms ou whatsapp.
# No Brasil prefira whatsapp: SMS exige registro prévio de sender ID junto às
# operadoras e não funciona em conta de teste.
TWILIO_CANAL=whatsapp

# Remetente. No sandbox de WhatsApp é o número do sandbox, não o seu.
# Console → Messaging → Try it out → Send a WhatsApp message.
TWILIO_REMETENTE=+14155238886

# DDI assumido quando o telefone vier sem ele.
SALAO_PAIS_PADRAO=55
