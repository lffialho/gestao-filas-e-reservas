# Copie para .env e preencha. O .env fica fora do git.
#   cp .env.example .env

# ---------------------------------------------------------------- serviço ---
PORTA=3000

# Token da equipe, exigido em toda rota menos /saude.
# Gere um: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SALAO_TOKEN=

# Caminho de um arquivo SQLite. Comente para manter o salão só em memória.
SALAO_BANCO=./salao.db

# ------------------------------------------------------------------ painel ---
# O painel roda num processo próprio: é ele que guarda o token, para que o
# navegador nunca veja. Use o mesmo SALAO_TOKEN acima.
PORTA_WEB=5173
SALAO_API=http://127.0.0.1:3000

# Senha do painel, pedida uma vez por turno.
#
# O painel escuta na rede para o tablet do balcão poder abri-lo, e é ele que
# carrega o SALAO_TOKEN. Sem senha, qualquer um no wifi do restaurante abre
# http://<ip-do-balcão>:5173 e manda no salão: senta gente, libera mesa,
# fecha o dia. Por isso o painel se recusa a subir sem esta variável.
#
# Uma por instalação, e não a mesma em todas as casas.
# Gere uma: node -e "console.log(require('node:crypto').randomBytes(9).toString('base64url'))"
PAINEL_SENHA=
